# Contraseña de administrador, hasheada con bcrypt.
# Generar con: node scripts/hash-password.mjs "tu-contraseña"
# IMPORTANTE: Next.js expande "$" en archivos .env, así que escapa cada "$" del hash como "\$"
# (el script de arriba ya imprime la línea lista para copiar).
ADMIN_PASSWORD_HASH=

# Secreto para firmar la cookie de sesión del panel /admin.
# Generar uno aleatorio con: openssl rand -base64 32
SESSION_SECRET=

# Se agrega automáticamente al conectar Vercel Blob desde el dashboard de Vercel.
# En local puedes dejarla vacía: el contenido y las fotos se guardan en /data y /public/uploads.
BLOB_READ_WRITE_TOKEN=

# Clave para cifrar los mensajes de contacto en reposo (AES-256-GCM).
# Obligatoria en producción (cualquier despliegue con BLOB_READ_WRITE_TOKEN);
# opcional en local (sin token de Blob, los mensajes se guardan en texto
# plano en data/messages.json, que nunca sale de tu máquina).
# Generar con: openssl rand -base64 32
# Si la pierdes o la rotas, los mensajes ya guardados quedan ilegibles —
# no hay forma de recuperarlos sin la clave original. Guárdala en un lugar
# seguro (gestor de contraseñas), no solo en Vercel.
MESSAGES_ENCRYPTION_KEY=

# Mientras no esté en "true", la home muestra "en construcción" a cualquiera
# que no haya iniciado sesión en /admin. Tú (logueado) siempre ves el sitio real.
# Ponla en "true" cuando quieras lanzar el sitio para todos.
SITE_LIVE=
